---
const workflow = [
  {
    label: "01",
    title: "Install the control plane",
    body: "One script prepares the host, starts the services, and leaves the stack in a place you can inspect.",
  },
  {
    label: "02",
    title: "Attach projects",
    body: "Create apps and databases from the same interface, then wire domains, env vars, logs, and backups around them.",
  },
  {
    label: "03",
    title: "Keep it running",
    body: "Use the panels you need day to day: deployments, database access, host health, updates, and storage.",
  },
];
---

<section id="platform" class="site-section bg-black text-white">
  <div class="site-noise" aria-hidden="true"></div>
  <div class="aero-container relative">
    <div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
      <div>
        <p class="section-label">After bootstrap</p>
        <h2 class="section-title">Your server gets a cockpit.</h2>
        <p class="section-copy mt-6">
          Aeroplane keeps the powerful parts visible: deploys, databases, domains, logs, backups, and host maintenance.
        </p>
      </div>

      <div class="border border-white/10 bg-[#070707]">
        {workflow.map((item) => (
          <article class="grid gap-4 border-b border-white/10 p-5 last:border-b-0 sm:grid-cols-[56px_minmax(0,1fr)] sm:p-6">
            <span class="font-mono text-[9px] tracking-[0.16em] text-zinc-700">{item.label}</span>
            <div>
              <h3 class="m-0 text-lg text-zinc-100">{item.title}</h3>
              <p class="mb-0 mt-2 max-w-2xl text-sm leading-7 text-zinc-600">{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>
