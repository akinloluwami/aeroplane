---
const items = [
  "docker.ready",
  "caddy.routing",
  "postgres.backed-up",
  "redis.live",
  "logs.streaming",
  "domains.issued",
  "updates.available",
  "buildkit.warm",
];
---

<div class="grid border-x border-t border-white/10 sm:grid-cols-2 lg:grid-cols-4" aria-label="Platform status ticker">
  {items.map((item) => (
    <div class="flex items-center gap-2 border-b border-r border-white/10 px-4 py-3 lg:[&:nth-last-child(-n+4)]:border-b-0">
      <span class="size-1 bg-zinc-700" aria-hidden="true"></span>
      <span class="font-mono text-[8px] text-zinc-600">{item}</span>
    </div>
  ))}
</div>
