---
import AeroplaneLogo from "./aeroplane-logo.astro";

const githubUrl = "https://github.com/xt42io/aeroplane";
---

<section class="site-section bg-[#050505] text-white">
  <div class="aero-container">
    <div class="relative overflow-hidden border border-white/15 bg-black px-6 py-12 sm:px-10 sm:py-16 lg:px-14">
      <AeroplaneLogo class="absolute -bottom-16 -right-10 size-72 text-white opacity-[0.035]" />
      <div class="relative grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <h2 class="section-title m-0 max-w-[12ch]">Star on GitHub</h2>
          <p class="section-copy mb-0 mt-6">
            Follow the project, watch the roadmap, and help more people find the self-hosted path.
          </p>
        </div>
        <a
          class="aero-button min-h-12 px-6"
          data-analytics-event="github_star_clicked"
          data-analytics-placement="github_star_section"
          href={githubUrl}
          rel="noreferrer"
          target="_blank"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="m12 2 2.98 6.04 6.67.97-4.82 4.7 1.14 6.64L12 17.22l-5.97 3.13 1.14-6.64-4.82-4.7 6.67-.97L12 2Z"></path>
          </svg>
          Star repo
        </a>
      </div>
    </div>
  </div>
</section>
