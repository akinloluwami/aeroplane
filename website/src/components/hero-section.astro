---
import GetStartedButton from "./get-started-button.astro";
import HeroCommandPanel from "./hero-command-panel.astro";
import HeroHeader from "./hero-header.astro";
import HeroMarquee from "./hero-marquee.astro";
import OrbitDecoration from "./orbit-decoration.astro";
---

<section class="relative min-h-[100svh] overflow-hidden bg-[#050505] text-white">
  <div class="site-noise" aria-hidden="true"></div>
  <OrbitDecoration class="pointer-events-none absolute -right-64 top-8 hidden h-[760px] w-[760px] opacity-90 lg:block" />

  <div class="aero-container relative z-[1] grid min-h-[100svh] grid-rows-[auto_1fr_auto]">
    <HeroHeader />

    <div class="grid items-center gap-14 py-16 lg:grid-cols-[minmax(0,0.86fr)_minmax(440px,0.7fr)] lg:py-24">
      <div>
        <h1 class="font-hero m-0 max-w-[12ch] text-[clamp(2.25rem,4.4vw,4.25rem)] leading-[1.02] tracking-[-0.05em] text-white">
          <span class="block text-zinc-500">Deploy apps</span>
          <span class="block">and databases</span>
          <span class="block">on your own server.</span>
        </h1>
        <p class="mt-7 max-w-xl font-mono text-[0.84rem] leading-7 text-zinc-500">
          Aeroplane gives you a self-hosted control plane for apps, databases, domains, logs,
          backups, and updates on infrastructure you own.
        </p>
        <div class="mt-8">
          <GetStartedButton />
        </div>
      </div>

      <div class="relative">
        <div class="absolute -left-3 -top-3 size-3 border-l border-t border-white/30" aria-hidden="true"></div>
        <div class="absolute -bottom-3 -right-3 size-3 border-b border-r border-white/30" aria-hidden="true"></div>
        <HeroCommandPanel />
      </div>
    </div>

    <HeroMarquee />
  </div>
</section>
