---
import VercelImportVisual from "./vercel-import-visual.astro";
import VercelLogo from "./vercel-logo.astro";

const importSteps = [
  {
    label: "01",
    title: "Connect Vercel",
    body: "Paste a Vercel API token, choose a personal account or team, and browse projects with connected Git sources.",
  },
  {
    label: "02",
    title: "Pick the runtime shape",
    body: "Choose production, preview, or development variables, skip Vercel system vars, and decide whether to deploy immediately.",
  },
  {
    label: "03",
    title: "Run it on your server",
    body: "Aeroplane recreates the Git service with root directory, commands, variables, and custom domains ready for self-hosted deploys.",
  },
];

const importDetails = [
  "Git repo, branch, and root directory",
  "Build and install command overrides",
  "Production, preview, or development variables",
  "Custom domains with vercel.app hostnames skipped",
];

const previewRows = [
  { key: "repo", value: "acme/web" },
  { key: "root", value: "apps/site" },
  { key: "env", value: "production" },
  { key: "deploy", value: "queued" },
];
---

<section class="site-section bg-[#050505] text-white">
  <div class="aero-container">
    <header class="grid gap-7 border-b border-white/10 pb-10 lg:grid-cols-[0.78fr_1fr] lg:items-end lg:gap-20">
      <div class="flex items-start gap-4">
        <span class="mt-1 grid size-11 shrink-0 place-items-center border border-white/15 text-white">
          <VercelLogo class="size-5" />
        </span>
        <h2 class="section-title m-0">Import from Vercel</h2>
      </div>
      <p class="section-copy m-0">
        Move a Vercel app into Aeroplane with its Git source, environment target, commands, and custom domains already shaped for your server.
      </p>
    </header>

    <div class="mt-10">
      <VercelImportVisual previewRows={previewRows} importDetails={importDetails} />
    </div>

    <section class="mt-4 divide-y divide-white/10 border border-white/10 bg-[#070707]">
      {importSteps.map((step) => (
        <article class="grid gap-3 px-5 py-4 sm:grid-cols-[40px_170px_minmax(0,1fr)] sm:items-start">
          <span class="font-mono text-[8px] tracking-[0.15em] text-zinc-700">{step.label}</span>
          <h3 class="m-0 text-sm text-zinc-200">{step.title}</h3>
          <p class="m-0 text-xs leading-6 text-zinc-600">{step.body}</p>
        </article>
      ))}
    </section>
  </div>
</section>
