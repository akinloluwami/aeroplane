---
import Copy01Icon from "@hugeicons/core-free-icons/Copy01Icon";
import CopyCheckIcon from "@hugeicons/core-free-icons/CopyCheckIcon";

const command = "curl -fsSL https://get.aeroplane.run | sh";
const capabilities = ["apps", "postgres", "redis", "domains", "backups", "logs"];
const previewLines = [
  ["resolve_preview", "app.example.com"],
  ["service_status", "api: active"],
  ["backup_window", "postgres: 02:00 UTC"],
];
const toPathAttrs = (icon) => icon.filter(([tag]) => tag === "path").map(([, attrs]) => ({
  d: attrs.d,
  stroke: attrs.stroke,
  "stroke-linecap": attrs.strokeLinecap,
  "stroke-linejoin": attrs.strokeLinejoin,
  "stroke-width": attrs.strokeWidth,
}));
const copyIconPaths = toPathAttrs(Copy01Icon);
const copiedIconPaths = toPathAttrs(CopyCheckIcon);
---

<div class="border border-white/15 bg-black">
  <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
    <p class="section-label">Bootstrap node</p>
    <span class="inline-flex items-center gap-2 font-mono text-[8px] uppercase tracking-[0.14em] text-emerald-300">
      <span class="status-dot"></span>Ready
    </span>
  </div>

  <div class="grid grid-cols-[minmax(0,1fr)_48px] border-b border-white/10 bg-zinc-950">
    <code class="min-w-0 overflow-hidden text-ellipsis whitespace-nowrap px-4 py-4 font-mono text-[10px] text-zinc-300">
      <span class="mr-2 text-zinc-700">&gt;</span>{command}
    </code>
    <button
      aria-label="Copy install command"
      class="grid place-items-center border-l border-white/10 text-zinc-500 transition hover:bg-white/[0.05] hover:text-white"
      data-copy-command={command}
      type="button"
    >
      <svg class="copy-icon size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        {copyIconPaths.map((attrs) => <path {...attrs} />)}
      </svg>
      <svg class="copied-icon hidden size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        {copiedIconPaths.map((attrs) => <path {...attrs} />)}
      </svg>
    </button>
  </div>

  <div class="p-4">
    <p class="section-label">Managed surface</p>
    <div class="mt-3 grid grid-cols-2 border-l border-t border-white/10 sm:grid-cols-3">
      {capabilities.map((capability) => (
        <span class="border-b border-r border-white/10 px-3 py-3 font-mono text-[9px] text-zinc-400">
          [{capability}]
        </span>
      ))}
      <span class="border-b border-r border-white/10 px-3 py-3 font-mono text-[9px] text-zinc-600 sm:col-span-3">
        [+ more]
      </span>
    </div>
  </div>

  <div class="border-t border-white/10 px-4 py-3" aria-label="Deployment preview">
    {previewLines.map(([label, value]) => (
      <p class="m-0 grid grid-cols-[112px_minmax(0,1fr)] gap-3 border-b border-white/[0.06] py-2 font-mono text-[9px] last:border-b-0">
        <span class="text-zinc-700">{label}</span>
        <span class="truncate text-zinc-400">{value}</span>
      </p>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll("[data-copy-command]").forEach((button) => {
    button.addEventListener("click", async () => {
      const command = button.getAttribute("data-copy-command") || "";
      try {
        await navigator.clipboard.writeText(command);
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = command;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.append(textarea);
        textarea.select();
        document.execCommand("copy");
        textarea.remove();
      }
      button.setAttribute("aria-label", "Copied install command");
      button.setAttribute("data-copied", "true");
      window["posthog"]?.capture?.("install_command_copied", { placement: "hero_command_panel" });
      window.setTimeout(() => {
        button.setAttribute("aria-label", "Copy install command");
        button.removeAttribute("data-copied");
      }, 1400);
    });
  });
</script>

<style>
  [data-copy-command][data-copied] .copy-icon { display: none; }
  [data-copy-command][data-copied] .copied-icon { display: block; }
</style>
