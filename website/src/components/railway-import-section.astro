---
import RailwayImportVisual from "./railway-import-visual.astro";
import RailwayLogo from "./railway-logo.astro";

const importSteps = [
  {
    label: "01",
    title: "Connect Railway",
    body: "Use a Railway personal API token to pull projects, environments, services, and deployment settings into view.",
  },
  {
    label: "02",
    title: "Choose what moves",
    body: "Pick the target environment and services, skip Railway-only variables, and decide whether databases should be recreated.",
  },
  {
    label: "03",
    title: "Land in Aeroplane",
    body: "Aeroplane creates the project, links app variables to new database credentials, imports custom domains where possible, and can queue deploys.",
  },
];

const importDetails = [
  "App variables and command overrides",
  "Postgres, MySQL, Redis, MongoDB, and Timescale services",
  "Database data imports for supported Postgres-family databases",
  "Custom domains and detected service ports",
];
---

<section id="migrate" class="site-section bg-black text-white">
  <div class="site-noise" aria-hidden="true"></div>
  <div class="aero-container relative">
    <header class="grid gap-7 border-b border-white/10 pb-10 lg:grid-cols-[0.78fr_1fr] lg:items-end lg:gap-20">
      <div class="flex items-start gap-4">
        <span class="mt-1 grid size-11 shrink-0 place-items-center border border-white/15 text-white">
          <RailwayLogo class="size-6" />
        </span>
        <h2 class="section-title m-0">Import from Railway</h2>
      </div>
      <p class="section-copy m-0">
        Move a Railway project into your self-hosted Aeroplane control plane without rebuilding the stack by hand.
        Services, variables, databases, and domains arrive as a project you can inspect and deploy.
      </p>
    </header>

    <div class="mt-10">
      <RailwayImportVisual />
    </div>

    <div class="mt-4 grid border border-white/10 bg-[#070707] lg:grid-cols-[0.8fr_1.2fr]">
      <section class="border-b border-white/10 p-5 lg:border-b-0 lg:border-r">
        <p class="section-label">Included in the import</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          {importDetails.map((detail, index) => (
            <div class="grid grid-cols-[26px_minmax(0,1fr)] items-start gap-2 text-xs leading-6 text-zinc-500">
              <span class="font-mono text-[7px] text-zinc-800">{String(index + 1).padStart(2, "0")}</span>
              <span>{detail}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="divide-y divide-white/10">
        {importSteps.map((step) => (
          <article class="grid gap-3 px-5 py-4 sm:grid-cols-[40px_170px_minmax(0,1fr)] sm:items-start">
            <span class="font-mono text-[8px] tracking-[0.15em] text-zinc-700">{step.label}</span>
            <h3 class="m-0 text-sm text-zinc-200">{step.title}</h3>
            <p class="m-0 text-xs leading-6 text-zinc-600">{step.body}</p>
          </article>
        ))}
      </section>
    </div>
  </div>
</section>
