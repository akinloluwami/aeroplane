---
import AeroplaneLogo from "./aeroplane-logo.astro";
---

<header class="flex min-h-16 items-center justify-between gap-5 border-b border-white/10 font-mono text-[10px] text-zinc-500 max-sm:flex-col max-sm:items-start max-sm:justify-center max-sm:py-4">
  <a class="inline-flex items-center gap-3 text-white" href="/">
    <span class="grid size-9 place-items-center border border-white/15 bg-white/[0.04]">
      <AeroplaneLogo class="size-[18px]" />
    </span>
    <span>Aeroplane</span>
  </a>

  <div class="flex flex-wrap items-center justify-end gap-3 max-sm:justify-start" aria-label="System status">
    <span class="status-dot" aria-hidden="true"></span>
    <span>control plane ready</span>
    <span aria-hidden="true">::</span>
    <a class="border-b border-zinc-700 text-zinc-300 transition hover:border-white hover:text-white" href="/docs/">docs</a>
    <span aria-hidden="true">::</span>
    <a
      class="border-b border-zinc-700 text-zinc-300 transition hover:border-white hover:text-white"
      data-analytics-event="github_link_clicked"
      data-analytics-placement="hero_header"
      href="https://github.com/xt42io/aeroplane"
    >source</a>
  </div>
</header>
